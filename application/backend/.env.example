# Copy to .env for local runs (never commit .env)
# Either give a full URL...
DATABASE_URL=postgresql+psycopg://stocksense:change-me@localhost:5432/stocksense
# ...or the parts (this is how Kubernetes passes them: ConfigMap + Secret)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stocksense
# DB_USER=stocksense
# DB_PASSWORD=change-me
APP_ENV=local
LOW_STOCK_DEFAULT=10
