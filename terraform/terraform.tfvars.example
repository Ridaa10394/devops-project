# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# AWS credentials do NOT go here - use `aws configure` / env vars / SSO.
aws_region          = "ap-south-1"
project_name        = "stocksense"
environment         = "dev"
vpc_cidr            = "10.42.0.0/16"
az_count            = 2
kubernetes_version  = "1.33"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3
single_nat_gateway  = true
cluster_admin_cidrs = ["203.0.113.10/32"] # replace with YOUR_IP/32
